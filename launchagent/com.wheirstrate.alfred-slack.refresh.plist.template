<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily refresh of the Slack Quick Switcher cache.
  Installed by launchagent/agent.zsh, which fills in the placeholders.
  If the Mac is asleep at the scheduled time, launchd runs the job on wake.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wheirstrate.alfred-slack.refresh</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>--no-rcs</string>
		<string>__REFRESH_SCRIPT__</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ALFRED_SLACK_INCLUDE_BOTS</key>
		<string>__INCLUDE_BOTS__</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>__HOUR__</integer>
		<key>Minute</key>
		<integer>__MINUTE__</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__LOG_FILE__</string>
	<key>StandardErrorPath</key>
	<string>__LOG_FILE__</string>
</dict>
</plist>
